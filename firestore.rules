rules_version = '2';

// FieldNotes AI — Firestore security rules.
//
// Notes live at users/{uid}/notes/{noteId}. The app signs every visitor in
// anonymously (Firebase Authentication → Anonymous), and these rules scope
// each user's notes strictly to their own uid: a signed-in user can read and
// write ONLY under their own users/{uid} path. Everything else is denied.
//
// DEPLOYMENT (required — the database runs in production mode, which denies
// all access until rules are published):
//   • Firebase console → Firestore Database → Rules → paste this file →
//     Publish, or
//   • firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/notes/{noteId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
